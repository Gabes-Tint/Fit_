{
	"name": "fit_",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24.18.0 <25",
		"bun": ">=1.3.9"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"fast-uri": "3.1.5",
		"nanoid": "3.3.18",
		"postcss": "8.5.23",
		"qs": "6.15.3"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:capacitor": "VITE_CAPACITOR=1 vite build",
		"android:sync": "bun run build:capacitor && cap sync android",
		"android:run": "bun run android:sync && cap run android",
		"android:release": "bun scripts/android/build-release.ts",
		"android:install": "bun scripts/android/install.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && git config core.hooksPath .githooks 2>/dev/null || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:scripts": "tsc --project ./scripts/tsconfig.json --noEmit",
		"check:suppressions": "bun scripts/quality/suppressions.ts",
		"check:thresholds": "bun scripts/quality/thresholds.ts",
		"check:mutation-reviews": "bun scripts/quality/mutation-review-check.ts",
		"check:mutation-oracle": "bun scripts/quality/mutation-oracle.ts",
		"mutation:repin": "bun scripts/quality/mutation-repin.ts",
		"check:workflows": "bun scripts/quality/actionlint.ts",
		"check:ci-contract": "bun scripts/quality/ci-contract.ts",
		"check:schedules": "bun scripts/quality/schedule-contract.ts",
		"check:bundle": "bun scripts/quality/bundle-budget.ts",
		"bundle:headroom": "bun scripts/quality/bundle-headroom.ts",
		"version:next": "bun scripts/build/next-version.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check --cache --cache-location reports/quality/cache/prettier .",
		"lint": "bun scripts/quality/eslint.ts",
		"lint:docs": "markdownlint-cli2",
		"spellcheck": "cspell --no-progress --cache --cache-location reports/quality/cache/cspell .",
		"knip": "knip",
		"duplicates:scan": "jscpd --no-tips --no-colors src scripts",
		"duplicates": "bun run duplicates:scan && bun scripts/quality/duplication.ts",
		"test:unit": "vitest run --reporter=default --reporter=json --outputFile.json=reports/quality/vitest.json",
		"test:unit:server": "vitest run --project server --reporter=default --reporter=json --outputFile.json=reports/quality/vitest-server.json",
		"test:coverage": "bun run test:coverage:client && bun run test:coverage:server",
		"test:coverage:client": "vitest run --coverage --project client --project client-node --coverage.include='src/lib/**/*.{ts,svelte}' --coverage.exclude='src/lib/server/**' --coverage.exclude='src/lib/domain/**' --coverage.exclude='src/**/*.{test,spec}.{js,ts}' --coverage.reportsDirectory=coverage/client --reporter=default --reporter=json --outputFile.json=reports/quality/vitest-client.json",
		"test:coverage:server": "vitest run --coverage --project server --coverage.include='src/lib/{server,domain}/**/*.ts' --coverage.exclude='src/**/*.{test,spec}.{js,ts}' --coverage.reportsDirectory=coverage/server --reporter=default --reporter=json --outputFile.json=reports/quality/vitest-server.json",
		"test:mutation": "bun run test:mutation:full",
		"test:mutation:security": "bun scripts/quality/mutation-run.ts security",
		"test:mutation:changed:node": "bun scripts/quality/mutation-run.ts changed-node",
		"test:mutation:changed:client": "bun scripts/quality/mutation-run.ts changed-client",
		"test:mutation:full": "bun scripts/quality/mutation-run.ts full",
		"test:mutation:fixture:full": "bun scripts/quality/mutation-verdict-check.ts full reports/mutation/fixture/scope.json reports/mutation/fixture/mutation.json reports/mutation/fixture/verdict.json",
		"report:mutation-debt": "bun scripts/quality/mutation-debt.ts",
		"debt:pay": "bun scripts/quality/debt-pay.ts",
		"test:gates": "bun scripts/quality/self-test.ts",
		"search:eval": "node scripts/eval/search-eval.ts",
		"perf:measure": "node scripts/perf/measure.ts",
		"check:perf-plans": "node scripts/perf/check-plans.ts",
		"test:e2e": "playwright test",
		"test:e2e:all": "E2E_ALL_BROWSERS=1 playwright test",
		"test:e2e:security": "bun scripts/security/zap.ts",
		"test": "bun run test:unit && bun run test:e2e",
		"as-owen": "bun scripts/github/as-owen.ts",
		"security:images": "bun scripts/security/images.ts",
		"security:gitleaks": "bun scripts/security/gitleaks.ts",
		"security:semgrep": "bun scripts/security/semgrep.ts",
		"security:trivy": "bun scripts/security/trivy.ts",
		"security:blocking": "bun run security:gitleaks && bun run security:semgrep",
		"security:advisory": "bun run security:trivy && bun run test:e2e:security",
		"security": "bun run security:blocking && bun run security:advisory",
		"deploy": "bun scripts/deploy/deploy.ts",
		"deploy:smoke": "bun scripts/deploy/smoke.ts",
		"dev:gate-slice": "bun scripts/dev/install-gate-slice.ts",
		"worktree:new": "bun scripts/dev/worktree.ts new",
		"worktree:done": "bun scripts/dev/worktree.ts done",
		"ci:rerun-failed": "bun scripts/ci/rerun-failed.ts",
		"precommit": "bun scripts/quality/gate.ts verify:fast --bail --only format:check,lint,check:suppressions",
		"verify:fast": "bun scripts/quality/gate.ts verify:fast",
		"verify": "bun scripts/quality/gate.ts verify",
		"verify:deep": "bun scripts/quality/gate.ts verify:deep",
		"verify:changed": "bun scripts/quality/verify-changed.ts",
		"ci": "bun scripts/quality/gate.ts ci",
		"audit:mutation": "bun scripts/quality/gate.ts audit",
		"nightly": "bun scripts/quality/gate.ts nightly"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@capacitor/cli": "^8.5.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@stryker-mutator/api": "10.0.0",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-istanbul": "^4.1.11",
		"@vitest/eslint-plugin": "^1.6.27",
		"cspell": "10.1.1",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-playwright": "^2.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jscpd": "5.0.16",
		"jsdom": "^30.0.1",
		"knip": "^6.32.3",
		"markdownlint-cli2": "0.23.2",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.0",
		"@capacitor/core": "^8.5.0",
		"@lucide/svelte": "^1.35.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1"
	}
}
