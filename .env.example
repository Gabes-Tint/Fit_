# Operator environment for this checkout. Copy to `.env` and fill.
# `.env` is gitignored. `bun run` loads it from the checkout root.
# Never commit real values. Never prefix these names with PUBLIC_ or VITE_.
#
# The production service file is a different thing: scripts/deploy/fit.env.example
# is installed once on the VM as /etc/fit/fit.env and is not this file.

# --- Deploy (required for `bun run deploy` and `bun run deploy:smoke`) ---
# SSH target, user@host. No default. The hostname is not in the repository.
FIT_DEPLOY_HOST=

# Origin the smoke check and deploy logs aim at. No default, so a forgotten
# value cannot hit production by accident. Production is https://fit.psilva.org.
FIT_PUBLIC_ORIGIN=

# Escape hatch only: skip the green-main check when that check itself is broken.
# FIT_DEPLOY_ALLOW_RED_MAIN=

# --- GitHub as Owen (`bun run as-owen gh …`) ---
# Path to the GitHub App private key. Mode 600; the script refuses group/other
# readable files. The app must be installed on Gabes-Tint/Fit_. Default app id
# is 4578638 if FIT_GITHUB_APP_ID is unset.
FIT_GITHUB_APP_KEY=
# FIT_GITHUB_APP_ID=4578638

# --- Android signed release (`bun run android:release`) ---
# Path to the keystore properties file: storeFile, storePassword, keyAlias,
# keyPassword. Unset produces an unsigned APK that will not install.
FIT_ANDROID_SIGNING_PROPERTIES=

# --- Local catalog (`search:eval`, `etl:audit`, `perf:measure`) ---
# Not in git. Default if unset: data/db/fit-food-core.sqlite
# Those three scripts are invoked with `node` and do not load this file.
# Export the variable, or: set -a; source .env; set +a
FIT_CATALOG_PATH=

# --- Cloudflare zone token (orchestrator) ---
# Path to a token that can read and write settings on the psilva.org zone.
# Never printed, echoed, logged or committed.
FIT_CLOUDFLARE_TOKEN_PATH=
