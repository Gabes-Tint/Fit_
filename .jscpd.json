{
	"threshold": 5,
	"minLines": 8,
	"minTokens": 70,
	"mode": "strict",
	"formats": ["javascript", "svelte", "typescript"],
	"ignore": [
		"**/*.{test,spec,e2e}.ts",
		"**/*.d.ts",
		"**/.svelte-kit/**",
		"**/node_modules/**",
		"**/reports/**"
	],
	"reporters": ["console", "json"],
	"output": "reports/quality/duplication",
	"absolute": false
}
