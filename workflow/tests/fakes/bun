#!/usr/bin/env python3
"""Fake `bun`: `run worktree:new <slug>` does a real `git worktree add`;
`x vitest run ...` / `x playwright test ...` emit a JSON report (the same
shape the real reporters use) built from a scripted outcome per file:
"fail" (good - no implementation yet) - or an object mapping each test
title in the file to its own outcome - "timed_out" (also good - an
expectation waiting for UI that does not exist yet, which playwright
reports as `timedOut` rather than `failed`), "fail_defect" (the test itself
throws, so it can never pass), "pass" (bad), "skipped" (the tests never
ran, so they prove nothing either way), "not_found" (the runner never ran
that file), or "tool_error" (no JSON report).

A failing file's report carries the test title and the error message the
driver classifies, taken from `test_messages[file]` when a scenario scripts
one and from the outcome's own default otherwise.

`run verify:changed` and `scripts/quality/gate.ts verify:fast --only ...`
write the report, the per-step logs and (for `duplicates`) the jscpd report
a real gate run leaves behind, so the driver reads its diagnostics out of
the same files it reads in the repository."""

import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

FLAGS = {
    "run",
    "test",
    "vitest",
    "playwright",
    "--reporter=json",
    "--project=mobile-chrome",
}


def world_dir():
    return Path(os.environ["FAKE_WORLD"])


def load():
    return json.loads((world_dir() / "world.json").read_text())


def save(world):
    path = world_dir() / "world.json"
    tmp = path.with_suffix(f".json.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(world, indent=2))
    tmp.replace(path)


def record(argv, **extra):
    with (world_dir() / "calls.jsonl").open("a") as f:
        f.write(json.dumps({"tool": "bun", "argv": argv, **extra}) + "\n")


def git(cwd, *args, check=True):
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and result.returncode != 0:
        raise RuntimeError(f"fake bun: git {' '.join(args)}: {result.stderr}")
    return result


def cmd_worktree_new(slug):
    repo = Path(os.environ["FIT_REPO"])
    path = repo / ".claude" / "worktrees" / slug
    # the real `worktree:new` fetches first, so the new worktree is based on
    # the origin/main that exists now rather than the one this clone last saw
    git(repo, "fetch", "origin")
    result = subprocess.run(
        ["git", "worktree", "add", "-b", slug, str(path), "origin/main"],
        cwd=repo,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(result.stderr, file=sys.stderr)
        return 1
    print(str(path))
    return 0


def cmd_worktree_done(argv):
    """`worktree:done`'s decision, from `scripts/dev/worktree.ts`: refuse
    uncommitted work or commits origin/main has never seen unless --force,
    and delete the branch only when it is merged."""
    slug = argv[2]
    force = "--force" in argv
    repo = Path(os.environ["FIT_REPO"])
    path = repo / ".claude" / "worktrees" / slug
    world = load()
    if slug in world.get("worktree_done_failures", []):
        print(f"Refusing:\n  {path} has uncommitted changes", file=sys.stderr)
        return 1
    if not path.exists():
        print(f"Refusing: {path} does not exist", file=sys.stderr)
        return 1
    git(repo, "fetch", "origin")
    branch = git(path, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    dirty = git(path, "status", "--porcelain").stdout.strip() != ""
    ahead = git(path, "log", "--oneline", f"origin/main..{branch}").stdout.strip()
    reasons = []
    if dirty:
        reasons.append(f"{path} has uncommitted changes")
    if ahead:
        reasons.append(f"{branch} has commits origin/main does not: {ahead}")
    if reasons and not force:
        print("Refusing:\n" + "\n".join(f"  {reason}" for reason in reasons), file=sys.stderr)
        return 1
    git(repo, "worktree", "remove", *(["--force"] if force else []), str(path))
    if ahead:
        print(f"Leaving branch {branch}: not merged into origin/main.")
    else:
        git(repo, "branch", "-d", branch)
    return 0


def _files(argv):
    return [arg for arg in argv[1:] if arg not in FLAGS and not arg.startswith("--")]


_FAILING = {"fail", "fail_defect", "import_error", "timed_out"}
_TITLE = "the behavior this slice asks for"
_EXPECTATION_MESSAGE = "AssertionError: expected undefined to be 42 // Object.is equality"
_DEFECT_MESSAGE = "TypeError: locator.boundingBox is not a function"
_TIMEOUT_MESSAGE = (
    "Test timeout of 30000ms exceeded.\n\n"
    "Error: expect(locator).toBeVisible() failed\n\n"
    "Locator: getByText('Today, ')\nExpected: visible\nTimeout: 30000ms"
)


def _failure(world, file, outcome):
    """The title, message and error location a failing file reports. An
    ordinary "fail" reports a plain failed expectation; "timed_out" reports
    the message playwright writes when an expectation waits for UI that
    never appears; "fail_defect" reports a thrown error, by default a
    TypeError located in the test file itself, and a scenario scripts both
    to choose what the driver has to classify."""
    if outcome == "timed_out":
        return _TITLE, _TIMEOUT_MESSAGE, ""
    if outcome != "fail_defect":
        return _TITLE, _EXPECTATION_MESSAGE, ""
    scripted = world.get("test_messages", {}).get(file, {})
    return _TITLE, scripted.get("message", _DEFECT_MESSAGE), scripted.get("location", file)


def _titles(world, file):
    """The test titles this file reports. A scenario scripts more than one
    when what the driver says about each of them is the point."""
    return world.get("test_titles", {}).get(file) or [_TITLE]


def _per_title(world, file, outcome):
    """(title, outcome) for every test this file reports. An outcome that is
    a mapping gives each named test its own result, which is how a scenario
    scripts the shape #421 hit: one test of a file failing while the rest of
    the file passes."""
    if isinstance(outcome, dict):
        return list(outcome.items())
    return [(title, outcome) for title in _titles(world, file)]


def _vitest_status(outcome):
    """vitest's own JSON reporter has no timed-out status: it records a
    test that ran out of time as an ordinary failed assertion, and a
    skipped one as `pending`."""
    if outcome == "skipped":
        return "pending"
    return "failed" if outcome in _FAILING else "passed"


def _playwright_status(outcome):
    """playwright records an expectation that never resolved as `timedOut`,
    not `failed` - the ordinary shape of a UI acceptance test with no
    implementation behind it yet."""
    if outcome == "timed_out":
        return "timedOut"
    if outcome == "skipped":
        return "skipped"
    return "failed" if outcome in _FAILING else "passed"


def _vitest_assertion(world, f, title, outcome):
    status = _vitest_status(outcome)
    _, message, location = _failure(world, f, outcome)
    stack = f"{message}\n    at {location}:12:30" if location else message
    return {
        "title": title,
        "fullName": title,
        "status": status,
        "failureMessages": [stack] if status == "failed" else [],
    }


def _vitest_report(files, outcomes, world):
    entries = []
    for f in files:
        outcome = outcomes.get(f, "fail")
        if outcome == "not_found":
            continue
        assertions = (
            []
            if outcome == "import_error"
            else [
                _vitest_assertion(world, f, title, each)
                for title, each in _per_title(world, f, outcome)
            ]
        )
        # a file whose every test was skipped is still a passing file to
        # vitest: only the assertions say nothing ran
        failed = any(entry["status"] == "failed" for entry in assertions)
        entries.append(
            {
                "name": f"/worktree/{f}",
                "status": "failed" if failed else "passed",
                "assertionResults": assertions,
            }
        )
    return {"testResults": entries}


def _playwright_result(world, f, outcome):
    status = _playwright_status(outcome)
    _, message, location = _failure(world, f, outcome)
    result = {"status": status}
    if status not in {"passed", "skipped"}:
        result["error"] = {"message": message}
        if location:
            result["error"]["location"] = {"file": location, "line": 12, "column": 30}
    return result


def _playwright_report(files, outcomes, world):
    suites = []
    for f in files:
        outcome = outcomes.get(f, "fail")
        if outcome == "not_found":
            continue
        suites.append(
            {
                "specs": [
                    {
                        "title": title,
                        "file": f,
                        "tests": [{"results": [_playwright_result(world, f, each)]}],
                    }
                    for title, each in _per_title(world, f, outcome)
                ]
            }
        )
    return {"suites": suites, "errors": []}


def cmd_test_run(argv):
    import fcntl

    lock_path = world_dir() / "world.lock"
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        world = load()
        outcomes = world.get("test_outcomes", {})
        files = _files(argv)
        effective = dict(outcomes)
        consumed = False
        for file in files:
            outcome = outcomes.get(file)
            if isinstance(outcome, list) and outcome:
                head = outcome.pop(0)
                effective[file] = head
                # an exhausted list stays sticky: further invocations of the
                # same file in the same run keep reporting the last outcome
                if not outcome:
                    outcomes[file] = head
                consumed = True
        if consumed:
            save(world)
    if any(effective.get(file) == "tool_error" for file in files):
        print("test runner unavailable")
        return 1
    report = (
        _playwright_report(files, effective, world)
        if "playwright" in argv
        else _vitest_report(files, effective, world)
    )
    print(json.dumps(report))
    return 0


def cmd_lint_changed():
    """Scripted `lint:changed`: outcome from `gate_outcomes["lint:changed"]`,
    defaulting to pass. "fail" prints eslint's stylish report - the file on a
    line of its own above the problems it owns - and exits 1; "tool_error"
    crashes with an exit code neither 0 nor 1.

    `lint_errors` scripts which file breaks which rule, because block 1 no
    longer asks only whether lint failed: the `@typescript-eslint/no-unsafe-*`
    family inside an acceptance test is the story's missing API showing
    through and is accepted, while every other rule is still a rejection."""
    outcome, world = _scripted_outcome("lint:changed")
    if outcome == "fail":
        # eslint prints its compliance summary to stdout and the error body
        # to stderr, so real diagnostics can land in both streams at once
        problems = world.get("lint_errors") or _DEFAULT_LINT_ERRORS
        print(f"lint:changed: {len(problems)} problem found in 1 file")
        print("lint errors:", file=sys.stderr)
        print(_stylish(problems), file=sys.stderr)
        return 1
    if outcome == "tool_error":
        print("eslint runner crashed", file=sys.stderr)
        return 2
    return 0


_DEFAULT_LINT_ERRORS = [
    {
        "file": "src/lib/workflow-probe.spec.ts",
        "rule": "@typescript-eslint/no-unsafe-call",
        "message": "Unsafe call of an `any` typed value.",
    }
]


def _stylish(problems):
    """eslint's stylish report: one header per file, then its problems."""
    lines = []
    for index, problem in enumerate(problems):
        if index == 0 or problem["file"] != problems[index - 1]["file"]:
            lines.append(problem["file"])
        message = problem.get("message") or "Unsafe call of an `any` typed value."
        lines.append(f"  {5 + index}:10  error  {message}  {problem['rule']}")
    return "\n".join(lines)


_CHECK_FAILURE_MESSAGE = "Argument of type 'number' is not assignable to parameter of type 'Locator'"


def cmd_check():
    """Scripted `check` (the repository's svelte-check type lane): outcome
    from `gate_outcomes["check"]`, defaulting to pass. "fail" prints the
    errors `type_errors` scripts - or one default error in
    `check_failure_file` - and exits 1; "tool_error" crashes with an exit
    code neither 0 nor 1.

    An error scripted with a TS code is printed in tsc's shape, which
    carries the code; one without is printed in svelte-check's own
    location-then-message shape, which does not. Both reach the repository
    for real, and block 1 has to read either."""
    outcome, world = _scripted_outcome("check")
    if outcome == "fail":
        errors = world.get("type_errors") or [
            {"file": world.get("check_failure_file", "src/routes/typed.e2e.ts")}
        ]
        for error in errors:
            print(_type_error_line(error))
        print(f"svelte-check found {len(errors)} errors and 0 warnings")
        return 1
    if outcome == "tool_error":
        print("svelte-check could not load the project", file=sys.stderr)
        return 2
    return 0


def _type_error_line(error):
    message = error.get("message") or _CHECK_FAILURE_MESSAGE
    if error.get("code"):
        return f"{error['file']}(12,30): error {error['code']}: {message}."
    return f"{error['file']}:12:30\nError: {message}. (ts)"


def _scripted_outcome(key, default="pass"):
    """One consumption of `gate_outcomes[key]`, list values popped in
    order, plus the world as it stood."""
    import fcntl

    lock_path = world_dir() / "world.lock"
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        world = load()
        outcome = world.get("gate_outcomes", {}).get(key, default)
        if isinstance(outcome, list) and outcome:
            outcome = outcome.pop(0)
            save(world)
    return outcome, world


