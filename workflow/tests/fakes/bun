#!/usr/bin/env python3
"""Fake `bun`: `run worktree:new <slug>` does a real `git worktree add`;
`x vitest run ...` / `x playwright test ...` pop a scripted exit code."""

import json
import os
import subprocess
import sys
from pathlib import Path


def world_dir():
    return Path(os.environ["FAKE_WORLD"])


def load():
    return json.loads((world_dir() / "world.json").read_text())


def save(world):
    (world_dir() / "world.json").write_text(json.dumps(world, indent=2))


def record(argv):
    with (world_dir() / "calls.jsonl").open("a") as f:
        f.write(json.dumps({"tool": "bun", "argv": argv}) + "\n")


def cmd_worktree_new(slug):
    repo = Path(os.environ["FIT_REPO"])
    path = repo / ".claude" / "worktrees" / slug
    result = subprocess.run(
        ["git", "worktree", "add", "-b", slug, str(path), "origin/main"],
        cwd=repo,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(result.stderr, file=sys.stderr)
        return 1
    print(str(path))
    return 0


def cmd_test_run():
    world = load()
    runs = world.get("test_runs", [])
    if not runs:
        print("fake bun: no scripted test run left", file=sys.stderr)
        return 1
    exit_code = runs.pop(0)
    save(world)
    return exit_code


def main() -> int:
    argv = sys.argv[1:]
    record(argv)
    if argv[:2] == ["run", "worktree:new"]:
        return cmd_worktree_new(argv[2])
    if argv[:1] == ["x"]:
        return cmd_test_run()
    print(f"fake bun: unsupported command {argv}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
