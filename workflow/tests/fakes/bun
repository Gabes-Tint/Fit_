def _clone_pair(world):
    """The two halves `duplicates` reports. A scenario that scripts more
    than one pair gets one per invocation, the last sticky: an implementer
    that removed its own half of a clone leaves a different clone behind,
    not the same one."""
    if world.get("clone_pairs"):
        return _next_clone_pair()
    pair = world.get("clone_locations") or [_DEFAULT_CLONE, _DEFAULT_CLONE]
    return pair[0], pair[1]


def _next_clone_pair():
    """One consumption of `clone_pairs`, under the same lock every other
    scripted sequence is popped under."""
    import fcntl

    with (world_dir() / "world.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        world = load()
        pairs = world["clone_pairs"]
        pair = pairs.pop(0) if len(pairs) > 1 else pairs[0]
        save(world)
    return pair[0], pair[1]


def _write_jscpd_report(cwd, world):
    """The report `duplicates` fails on, in jscpd's own shape: one clone,
    both halves located, paths relative to jscpd's scan roots."""
    first, second = _clone_pair(world)
    report = {
        "duplicates": [
            {
                "format": "typescript",
                "lines": 10,
                "tokens": 86,
                "firstFile": {"name": first, "start": 40, "end": 49},
                "secondFile": {"name": second, "start": 90, "end": 99},
            }
        ],
        "statistics": {"total": {"clones": 1, "duplicatedLines": 9}},
    }
    path = cwd / "reports" / "quality" / "duplication" / "jscpd-report.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(report, indent=2) + "\n")
    return (
        "$ jscpd --no-tips --no-colors src scripts\n"
        "Clone found (typescript)\n"
        f" - {first} [40:3 - 49:40] (10 lines, 86 tokens)\n"
        f"   {second} [90:3 - 99:40]\n"
        "Duplication: 1 clones, 9 duplicated lines, ratchet 0.\n"
        "\n1 clones exceed the ratchet of 0. "
        "See reports/quality/duplication/jscpd-report.json.\n"
    )


def _write_step_log(cwd, label, step, text):
    """The log `runLoggedStep` writes, at the path the report points at."""
    directory = cwd / "reports" / "quality" / "logs" / label.replace(":", "-")
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"{step.replace(':', '-').replace('/', '-')}.log"
    path.write_text(text)
    return str(path.relative_to(cwd))


def _gate_report(cwd, world, label, failed):
    """Write the report and the per-step logs a real gate run leaves, and
    return the report's own `ok`."""
    steps = []
    for step in failed:
        detail = (
            _write_jscpd_report(cwd, world)
            if step == "duplicates"
            else _STEP_DETAIL.get(step, f"{step} failed").format(
                file=world.get("gate_failure_file", "src/lib/probe.spec.ts")
            )
        )
        steps.append(
            {
                "name": step,
                "command": f"bun run {step}",
                "ok": False,
                "outcome": "failed",
                "exitCode": 1,
                "log": _write_step_log(cwd, label, step, detail),
            }
        )
    payload = {
        "tier": label,
        "ok": not failed,
        "stepsRun": 3,
        "failed": list(failed),
        "crashed": [],
        "steps": steps,
    }
    report = cwd / "reports" / "quality" / f"gate-{label.replace(':', '-')}.json"
    report.parent.mkdir(parents=True, exist_ok=True)
    report.write_text(json.dumps(payload, indent=2) + "\n")


def _failed_steps(world, label, default):
    return world.get("gate_failed_steps", {}).get(label, default)


def cmd_verify_changed():
    """Scripted pre-push gate: outcome from `gate_outcomes["verify:changed"]`.
    "pass" writes a fresh green gate report and exits 0; "fail" writes a
    report with a failed step, its log and - for `duplicates` - a jscpd
    report, and exits 1; "stale" exits 0 without writing anything;
    "tool_error" crashes (exit 97) without writing anything."""
    outcome, world = _scripted_outcome("verify:changed")
    if outcome == "tool_error":
        print("verify:changed crashed before writing its report", file=sys.stderr)
        return 97
    if outcome == "stale":
        # write a report that predates the turn: the driver must refuse it
        report = Path.cwd() / "reports" / "quality" / "gate-verify-changed.json"
        report.parent.mkdir(parents=True, exist_ok=True)
        stale = time.time() - 3600
        report.write_text(json.dumps({"ok": True, "failed": [], "crashed": []}) + "\n")
        os.utime(report, (stale, stale))
        return 0
    failed = [] if outcome == "pass" else _failed_steps(world, "verify:changed", ["test:unit:server"])
    _gate_report(Path.cwd(), world, "verify:changed", failed)
    if failed:
        print(f"Failed steps: {', '.join(failed)}", file=sys.stderr)
        return 1
    return 0


def cmd_static_gate(argv):
    """Scripted `gate.ts verify:fast --only <steps>`, block 1's content
    steps over the failing-test branch: outcome from
    `gate_outcomes["verify:fast"]`, defaulting to pass. "fail" writes the
    same report, logs and jscpd report a real failure leaves."""
    outcome, world = _scripted_outcome("verify:fast")
    if outcome == "tool_error":
        print("gate.ts crashed before writing its report", file=sys.stderr)
        return 97
    failed = [] if outcome == "pass" else _failed_steps(world, "verify:fast", ["duplicates"])
    _gate_report(Path.cwd(), world, "verify:fast", failed)
    if failed:
        print(f"Failed steps: {', '.join(failed)}", file=sys.stderr)
        return 1
    return 0


