#!/usr/bin/env python3
"""Fake `bun`: `run worktree:new <slug>` does a real `git worktree add`;
`x vitest run ...` / `x playwright test ...` emit a JSON report (the same
shape the real reporters use) built from a scripted outcome per file:
"fail" (good - no implementation yet), "pass" (bad), "not_found" (the
runner never ran that file), or "tool_error" (no JSON report)."""

import json
import os
import subprocess
import sys
import time
from pathlib import Path

FLAGS = {
    "run",
    "test",
    "vitest",
    "playwright",
    "--reporter=json",
    "--project=mobile-chrome",
}


def world_dir():
    return Path(os.environ["FAKE_WORLD"])


def load():
    return json.loads((world_dir() / "world.json").read_text())


def save(world):
    path = world_dir() / "world.json"
    tmp = path.with_suffix(f".json.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(world, indent=2))
    tmp.replace(path)


def record(argv, **extra):
    with (world_dir() / "calls.jsonl").open("a") as f:
        f.write(json.dumps({"tool": "bun", "argv": argv, **extra}) + "\n")


def git(cwd, *args, check=True):
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and result.returncode != 0:
        raise RuntimeError(f"fake bun: git {' '.join(args)}: {result.stderr}")
    return result


def cmd_worktree_new(slug):
    repo = Path(os.environ["FIT_REPO"])
    path = repo / ".claude" / "worktrees" / slug
    # the real `worktree:new` fetches first, so the new worktree is based on
    # the origin/main that exists now rather than the one this clone last saw
    git(repo, "fetch", "origin")
    result = subprocess.run(
        ["git", "worktree", "add", "-b", slug, str(path), "origin/main"],
        cwd=repo,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(result.stderr, file=sys.stderr)
        return 1
    print(str(path))
    return 0


def cmd_worktree_done(argv):
    """`worktree:done`'s decision, from `scripts/dev/worktree.ts`: refuse
    uncommitted work or commits origin/main has never seen unless --force,
    and delete the branch only when it is merged."""
    slug = argv[2]
    force = "--force" in argv
    repo = Path(os.environ["FIT_REPO"])
    path = repo / ".claude" / "worktrees" / slug
    world = load()
    if slug in world.get("worktree_done_failures", []):
        print(f"Refusing:\n  {path} has uncommitted changes", file=sys.stderr)
        return 1
    if not path.exists():
        print(f"Refusing: {path} does not exist", file=sys.stderr)
        return 1
    git(repo, "fetch", "origin")
    branch = git(path, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    dirty = git(path, "status", "--porcelain").stdout.strip() != ""
    ahead = git(path, "log", "--oneline", f"origin/main..{branch}").stdout.strip()
    reasons = []
    if dirty:
        reasons.append(f"{path} has uncommitted changes")
    if ahead:
        reasons.append(f"{branch} has commits origin/main does not: {ahead}")
    if reasons and not force:
        print("Refusing:\n" + "\n".join(f"  {reason}" for reason in reasons), file=sys.stderr)
        return 1
    git(repo, "worktree", "remove", *(["--force"] if force else []), str(path))
    if ahead:
        print(f"Leaving branch {branch}: not merged into origin/main.")
    else:
        git(repo, "branch", "-d", branch)
    return 0


def _files(argv):
    return [arg for arg in argv[1:] if arg not in FLAGS and not arg.startswith("--")]


def _vitest_report(files, outcomes):
    entries = []
    for f in files:
        outcome = outcomes.get(f, "fail")
        if outcome == "not_found":
            continue
        status = "failed" if outcome in {"fail", "import_error"} else "passed"
        assertions = [] if outcome == "import_error" else [{"status": status}]
        entries.append({"name": f"/worktree/{f}", "status": status, "assertionResults": assertions})
    return {"testResults": entries}


def _playwright_report(files, outcomes):
    suites = []
    for f in files:
        outcome = outcomes.get(f, "fail")
        if outcome == "not_found":
            continue
        status = "failed" if outcome == "fail" else "passed"
        suites.append({"specs": [{"file": f, "tests": [{"results": [{"status": status}]}]}]})
    return {"suites": suites}


def cmd_test_run(argv):
    import fcntl

    lock_path = world_dir() / "world.lock"
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        world = load()
        outcomes = world.get("test_outcomes", {})
        files = _files(argv)
        effective = dict(outcomes)
        consumed = False
        for file in files:
            outcome = outcomes.get(file)
            if isinstance(outcome, list) and outcome:
                head = outcome.pop(0)
                effective[file] = head
                # an exhausted list stays sticky: further invocations of the
                # same file in the same run keep reporting the last outcome
                if not outcome:
                    outcomes[file] = head
                consumed = True
        if consumed:
            save(world)
    if any(effective.get(file) == "tool_error" for file in files):
        print("test runner unavailable")
        return 1
    report = (
        _playwright_report(files, effective)
        if "playwright" in argv
        else _vitest_report(files, effective)
    )
    print(json.dumps(report))
    return 0


def cmd_lint_changed():
    """Scripted `lint:changed`: outcome from `gate_outcomes["lint:changed"]`,
    defaulting to pass. "fail" prints eslint-style errors to stderr and exits
    1; "tool_error" crashes with an exit code neither 0 nor 1."""
    import fcntl

    lock_path = world_dir() / "world.lock"
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        world = load()
        outcome = world.get("gate_outcomes", {}).get("lint:changed", "pass")
        if isinstance(outcome, list) and outcome:
            outcome = outcome.pop(0)
            save(world)
    if outcome == "fail":
        # eslint prints its compliance summary to stdout and the error body
        # to stderr, so real diagnostics can land in both streams at once
        print("lint:changed: 1 problem found in 1 file")
        print("lint errors:", file=sys.stderr)
        print(_LINT_FAILURE_DETAIL, file=sys.stderr)
        return 1
    if outcome == "tool_error":
        print("eslint runner crashed", file=sys.stderr)
        return 2
    return 0


_LINT_FAILURE_DETAIL = (
    "src/lib/workflow-probe.spec.ts: 5:10 error Unsafe call of an `any` typed "
    "value @typescript-eslint/no-unsafe-call"
)


def cmd_verify_changed():
    """Scripted pre-push gate: outcome from `gate_outcomes["verify:changed"]`.
    "pass" writes a fresh green gate report and exits 0; "fail" writes a
    report with a failed step and exits 1; "stale" exits 0 without writing
    anything; "tool_error" crashes (exit 97) without writing anything."""
    import fcntl

    lock_path = world_dir() / "world.lock"
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        world = load()
        outcomes = world.get("gate_outcomes", {})
        outcome = outcomes.get("verify:changed", "pass")
        if isinstance(outcome, list) and outcome:
            outcome = outcome.pop(0)
            save(world)
    if outcome == "tool_error":
        print("verify:changed crashed before writing its report", file=sys.stderr)
        return 97
    if outcome == "stale":
        # write a report that predates the turn: the driver must refuse it
        report = Path.cwd() / "reports" / "quality" / "gate-verify-changed.json"
        report.parent.mkdir(parents=True, exist_ok=True)
        stale = time.time() - 3600
        report.write_text(json.dumps({"ok": True, "failed": [], "crashed": []}) + "\n")
        os.utime(report, (stale, stale))
        return 0
    report = Path.cwd() / "reports" / "quality" / "gate-verify-changed.json"
    report.parent.mkdir(parents=True, exist_ok=True)
    passed = outcome == "pass"
    payload = {
        "tier": "verify:changed",
        "ok": passed,
        "stepsRun": 3,
        "failed": [] if passed else ["test:unit:server"],
        "crashed": [],
    }
    report.write_text(json.dumps(payload) + "\n")
    if not passed:
        print("verify:changed: test:unit:server failed", file=sys.stderr)
        return 1
    return 0


def _smoke_report(ok, release, expected, failure=None):
    """The fields `scripts/deploy/smoke.ts` writes: no commit of its own,
    only the check whose detail names the release it asserted."""
    passed = [
        {"name": "the sign-in page is served by this app", "detail": "GET /signin -> 200"},
        {
            "name": "the live release is this commit",
            "detail": f"/opt/fit/current -> {release}, expected {expected}",
        },
    ]
    report = {"ok": ok, "ranAt": "2026-09-12T00:00:00.000Z", "passed": passed}
    if failure is not None:
        report["failure"] = failure
    return report


def cmd_deploy(argv):
    """`bun run deploy [--tunnel]`: the env and the checkout it was given
    are the contract with the real script, so both are recorded."""
    cwd = Path.cwd()
    head = git(cwd, "rev-parse", "HEAD").stdout.strip()
    host = os.environ.get("FIT_DEPLOY_HOST", "")
    origin = os.environ.get("FIT_PUBLIC_ORIGIN", "")
    record(
        argv,
        env={"FIT_DEPLOY_HOST": host, "FIT_PUBLIC_ORIGIN": origin},
        cwd=str(cwd),
        head=head,
    )
    if host == "" or origin == "":
        print("FIT_DEPLOY_HOST must name the deployment target", file=sys.stderr)
        return 1
    outcome = load().get("deploy_outcomes", {}).get(host, "ok")
    report_path = cwd / "reports" / "deploy" / "smoke.json"
    print(f"Deploying {head} to {host}.")
    if outcome == "health_failed":
        # activation failed: `deploy.ts` returns before `smoke()`, so no
        # report is written at all
        print(f"{head} never answered on /signin; rolled back.", file=sys.stderr)
        return 1
    report_path.parent.mkdir(parents=True, exist_ok=True)
    if outcome == "smoke_failed":
        failure = "sign-in returns a session: POST /api/sessions -> 500"
        report_path.write_text(json.dumps(_smoke_report(False, head, head, failure), indent=2))
        print(f"  FAIL {failure}", file=sys.stderr)
        return 1
    if outcome == "wrong_release":
        # green report, wrong release: the exit code says shipped and only
        # reading the report says which commit
        report_path.write_text(json.dumps(_smoke_report(True, "deadbeef", "deadbeef"), indent=2))
        return 0
    report_path.write_text(json.dumps(_smoke_report(True, head, head), indent=2))
    return 0


_APK = "android/app/build/outputs/apk/release/app-release.apk"
_APK_SHA = "3b1f" + "0" * 60


def cmd_android_release(argv):
    cwd = Path.cwd()
    record(argv, cwd=str(cwd))
    if load().get("android_outcome", "ok") != "ok":
        print("apksigner refused the APK it just built", file=sys.stderr)
        return 1
    print(f"\nAPK: {cwd / _APK}")
    print(f"SHA-256: {_APK_SHA}")
    return 0


def main() -> int:
    argv = sys.argv[1:]
    if argv[:2] == ["run", "deploy"]:
        return cmd_deploy(argv)
    if argv[:2] == ["run", "android:release"]:
        return cmd_android_release(argv)
    record(argv)
    if argv[:2] == ["run", "worktree:new"]:
        return cmd_worktree_new(argv[2])
    if argv[:2] == ["run", "worktree:done"]:
        return cmd_worktree_done(argv)
    if argv[:1] == ["x"]:
        return cmd_test_run(argv)
    if argv[:2] == ["run", "lint:changed"]:
        return cmd_lint_changed()
    if argv[:2] == ["run", "verify:changed"]:
        return cmd_verify_changed()
    print(f"fake bun: unsupported command {argv}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
