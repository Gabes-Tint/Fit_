def cmd_markdown(argv, tool):
    """Scripted `bun x prettier --check <md>` and `bun x cspell
    --no-progress <md>`: the markdown half of a workflow slice's gates.
    Outcome from `gate_outcomes[tool]`, defaulting to pass. "fail" prints
    the tool's own diagnostic naming a file and exits 1."""
    outcome, world = _scripted_outcome(tool)
    if outcome == "tool_error":
        print(f"{tool} crashed before it checked anything", file=sys.stderr)
        return 2
    if outcome != "fail":
        return 0
    files = [arg for arg in argv[2:] if not arg.startswith("--")]
    named = world.get("markdown_failure_file") or (files[0] if files else "workflow/README.md")
    print(_MARKDOWN_FAILURE[tool].format(file=named))
    return 1


def _smoke_report(ok, release, expected, failure=None):
    """The fields `scripts/deploy/smoke.ts` writes: no commit of its own,
    only the check whose detail names the release it asserted."""
    passed = [
        {"name": "the sign-in page is served by this app", "detail": "GET /signin -> 200"},
        {
            "name": "the live release is this commit",
            "detail": f"/opt/fit/current -> {release}, expected {expected}",
        },
    ]
    report = {"ok": ok, "ranAt": "2026-09-12T00:00:00.000Z", "passed": passed}
    if failure is not None:
        report["failure"] = failure
    return report


def _break_scripted_indexes(world):
    """Mid-run damage, scripted by `given_status_unreadable`: a linked
    worktree whose index stops being readable. Applied while the deploy
    runs because that is after the work is frozen and before cleanup,
    which is exactly where an unreadable status used to read as clean."""
    repo = Path(os.environ["FIT_REPO"])
    for slug in world.get("unreadable_status", []):
        index = repo / ".git" / "worktrees" / slug / "index"
        if index.exists():
            index.write_bytes(b"not an index")


def _ship_record_now():
    """What the driver has persisted at the moment the deploy starts. A run
    killed here is the case the started marker exists for, so the record as
    the deploy found it is part of the contract, not an implementation
    detail."""
    home = Path(os.environ.get("FIT_FLOW_HOME", ""))
    states = sorted((home / "runs").glob("story-*.json")) if str(home) else []
    if not states:
        return {}
    return json.loads(states[-1].read_text()).get("delivery", {}).get("ship", {})


def cmd_deploy(argv):
    """`bun run deploy [--tunnel]`: the env and the checkout it was given
    are the contract with the real script, so both are recorded."""
    cwd = Path.cwd()
    head = git(cwd, "rev-parse", "HEAD").stdout.strip()
    host = os.environ.get("FIT_DEPLOY_HOST", "")
    origin = os.environ.get("FIT_PUBLIC_ORIGIN", "")
    record(
        argv,
        env={"FIT_DEPLOY_HOST": host, "FIT_PUBLIC_ORIGIN": origin},
        cwd=str(cwd),
        head=head,
        ship=_ship_record_now(),
    )
    if host == "" or origin == "":
        print("FIT_DEPLOY_HOST must name the deployment target", file=sys.stderr)
        return 1
    world = load()
    _break_scripted_indexes(world)
    outcome = world.get("deploy_outcomes", {}).get(host, "ok")
    report_path = cwd / "reports" / "deploy" / "smoke.json"
    print(f"Deploying {head} to {host}.")
    if outcome == "health_failed":
        # activation failed: `deploy.ts` returns before `smoke()`, so no
        # report is written at all
        print(f"{head} never answered on /signin; rolled back.", file=sys.stderr)
        return 1
    if outcome == "no_report":
        # `deploy.ts` returned 0 without ever writing a report - the case a
        # previous deploy's report in the same checkout used to answer for
        print("Activated, but the smoke check never ran.")
        return 0
    if outcome == "crash":
        # killed mid-activation: the symlink may already have moved and
        # nothing was ever verified
        print("ssh: connection closed by remote host", file=sys.stderr)
        return 9
    report_path.parent.mkdir(parents=True, exist_ok=True)
    if outcome == "smoke_failed":
        failure = "sign-in returns a session: POST /api/sessions -> 500"
        report_path.write_text(json.dumps(_smoke_report(False, head, head, failure), indent=2))
        print(f"  FAIL {failure}", file=sys.stderr)
        return 1
    if outcome == "wrong_release":
        # green report, wrong release: the exit code says shipped and only
        # reading the report says which commit
        report_path.write_text(json.dumps(_smoke_report(True, "deadbeef", "deadbeef"), indent=2))
        return 0
    report_path.write_text(json.dumps(_smoke_report(True, head, head), indent=2))
    return 0


_APK = "android/app/build/outputs/apk/release/app-release.apk"


def cmd_android_release(argv):
    """A real file at `RELEASE_APK_PATH`, with the sha256 it really has -
    the driver copies that file out of this worktree and re-hashes it, so
    a printed constant would prove nothing. "wrong_sha" prints a hash of
    something else, which is what a truncated copy looks like."""
    cwd = Path.cwd()
    record(argv, cwd=str(cwd))
    outcome = load().get("android_outcome", "ok")
    if outcome not in {"ok", "wrong_sha"}:
        print("apksigner refused the APK it just built", file=sys.stderr)
        return 1
    server = next((arg for arg in argv if arg.startswith("--server-url=")), "")
    body = f"fake signed apk {server}\n".encode()
    apk = cwd / _APK
    apk.parent.mkdir(parents=True, exist_ok=True)
    apk.write_bytes(body)
    digest = hashlib.sha256(body if outcome == "ok" else body + b"not what was built")
    print(f"\nAPK: {apk}")
    print(f"SHA-256: {digest.hexdigest()}")
    return 0


def main() -> int:
    argv = sys.argv[1:]
    if argv[:2] == ["run", "deploy"]:
        return cmd_deploy(argv)
    if argv[:2] == ["run", "android:release"]:
        return cmd_android_release(argv)
    record(argv)
    if argv[:2] == ["run", "worktree:new"]:
        return cmd_worktree_new(argv[2])
    if argv[:2] == ["run", "worktree:done"]:
        return cmd_worktree_done(argv)
    if argv[:2] in (["x", "prettier"], ["x", "cspell"]):
        return cmd_markdown(argv, argv[1])
    if argv[:1] == ["x"]:
        return cmd_test_run(argv)
    if argv[:2] == ["run", "lint:changed"]:
        return cmd_lint_changed()
    if argv[:2] == ["run", "check"]:
        return cmd_check()
    if argv[:2] == ["run", "verify:changed"]:
        return cmd_verify_changed()
    if argv[:1] == ["scripts/quality/gate.ts"]:
        return cmd_static_gate(argv)
    print(f"fake bun: unsupported command {argv}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
