#!/usr/bin/env python3
# https://github.com/Gabes-Tint/Fit_/issues/351
# cspell:ignore fcntl
"""Fake `gh`: exactly the subcommands go.py's github.py uses."""

import json
import os
import subprocess
import sys
import fcntl
from pathlib import Path


def world_path():
    return Path(os.environ["FAKE_WORLD"]) / "world.json"


def load():
    return json.loads(world_path().read_text())


def save(world):
    path = world_path()
    tmp = path.with_suffix(f".json.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(world, indent=2))
    tmp.replace(path)


def record(argv):
    calls = Path(os.environ["FAKE_WORLD"]) / "calls.jsonl"
    with calls.open("a") as f:
        f.write(json.dumps({"tool": "gh", "argv": argv}) + "\n")


def opt(argv, name, default=None):
    return argv[argv.index(name) + 1] if name in argv else default


def all_opts(argv, name):
    return [argv[i + 1] for i, arg in enumerate(argv) if arg == name]


def issue_json(number, issue):
    return {
        "number": number,
        "title": issue["title"],
        "body": issue.get("body", ""),
        "labels": [{"name": label} for label in issue.get("labels", [])],
        "state": issue.get("state", "OPEN"),
        "assignees": [{"login": login} for login in issue.get("assignees", [])],
    }


def cmd_list(argv, world):
    state = opt(argv, "--state", "open")
    label = opt(argv, "--label")
    limit = int(opt(argv, "--limit", "30"))
    rows = []
    for number_str, issue in world["issues"].items():
        if state and issue.get("state", "OPEN").lower() != state.lower():
            continue
        if label and label not in issue.get("labels", []):
            continue
        rows.append(issue_json(int(number_str), issue))
    rows.sort(key=lambda row: row["number"])
    print(json.dumps(rows[:limit]))
    return 0


def cmd_view(argv, world):
    number = int(argv[2])
    issue = world["issues"].get(str(number))
    if issue is None:
        print(f"issue #{number} not found", file=sys.stderr)
        return 1
    print(json.dumps(issue_json(number, issue)))
    return 0


def cmd_edit(argv, world):
    number = int(argv[2])
    issue = world["issues"][str(number)]
    label = opt(argv, "--add-label")
    if label and label not in issue.setdefault("labels", []):
        issue["labels"].append(label)
    removed = opt(argv, "--remove-label")
    if removed and removed in issue.setdefault("labels", []):
        issue["labels"].remove(removed)
    login = opt(argv, "--add-assignee")
    if login and login not in issue.setdefault("assignees", []):
        issue["assignees"].append(login)
    save(world)
    return 0


def cmd_issue_close(argv, world):
    number = int(argv[2])
    issue = world["issues"][str(number)]
    issue["state"] = "CLOSED"
    body = opt(argv, "--comment")
    if body:
        issue.setdefault("comments", []).append(body)
    save(world)
    return 0


def cmd_comment(argv, world):
    number = int(argv[2])
    body = opt(argv, "--body")
    world["issues"][str(number)].setdefault("comments", []).append(body)
    save(world)
    return 0


def cmd_create(argv, world):
    title = opt(argv, "--title")
    body = opt(argv, "--body")
    labels = all_opts(argv, "--label")
    number = world.get("next_issue_number", 1000)
    world["next_issue_number"] = number + 1
    world["issues"][str(number)] = {
        "title": title,
        "body": body,
        "labels": labels,
        "state": "OPEN",
        "assignees": [],
        "comments": [],
    }
    save(world)
    print(f"https://github.com/Gabes-Tint/Fit_/issues/{number}")
    return 0


def cmd_api(argv, world):
    endpoint = argv[1]
    parts = endpoint.split("?", 1)[0].split("/")
    number = parts[4]
    resource = parts[5]
    issue = world["issues"][number]
    resource_keys = {"comments": "api_comments", "timeline": "timeline"}
    resource_key = resource_keys.get(resource)
    if resource_key is None:
        print(f"fake gh: unsupported api endpoint {endpoint}", file=sys.stderr)
        return 1
    rows = issue.get(resource_key, [])
    print(json.dumps([rows]))
    return 0


def _pr(world, number):
    pull = world.get("prs", {}).get(str(number))
    if pull is None:
        print(f"pull request #{number} not found", file=sys.stderr)
        return None
    return pull


def cmd_pr_create(argv, world):
    title = opt(argv, "--title")
    body = opt(argv, "--body")
    head = opt(argv, "--head")
    number = world.get("next_pr_number", 500)
    world["next_pr_number"] = number + 1
    world.setdefault("prs", {})[str(number)] = {
        "title": title,
        "body": body,
        "head": head,
        "state": "OPEN",
        "merged": False,
    }
    save(world)
    print(f"https://github.com/Gabes-Tint/Fit_/pull/{number}")
    return 0


def cmd_pr_view(argv, world):
    number = int(argv[2])
    pull = _pr(world, number)
    if pull is None:
        return 1
    fields = (opt(argv, "--json") or "").split(",")
    if "mergeCommit" in fields:
        sha = pull.get("mergeCommit")
        print(json.dumps({"mergeCommit": {"oid": sha} if sha else None}))
        return 0
    print(json.dumps({"number": number, "state": pull["state"], "headRefName": pull["head"]}))
    return 0


def cmd_pr_checks(argv, world):
    number = int(argv[2])
    pull = _pr(world, number)
    if pull is None:
        return 1
    outcomes = world.get("check_outcomes", {}).get(f"pr-{number}")
    if isinstance(outcomes, list) and outcomes:
        # consumed one value per invocation, like the test runners' fakes
        outcome = outcomes.pop(0)
        if not outcomes:
            world["check_outcomes"][f"pr-{number}"] = outcome
        save(world)
    else:
        outcome = outcomes if outcomes else "pass"
    states = {
        "pass": {
            "Quality and security": "SUCCESS",
            "Static analysis": "SUCCESS",
            "End-to-end (mobile-chrome)": "SUCCESS",
        },
        "fail": {
            "Quality and security": "FAILURE",
            "Static analysis": "SUCCESS",
            "End-to-end (mobile-chrome)": "SUCCESS",
        },
        # the shard kind block 5 reads as a flake signal when it is what the
        # one counted rerun reran
        "fail_e2e": {
            "Quality and security": "FAILURE",
            "Static analysis": "SUCCESS",
            "End-to-end (mobile-chrome)": "FAILURE",
        },
        # a job failed while the run is still executing: the driver must
        # wait for the run to complete before `gh run rerun --failed`
        "fail_running": {
            "Quality and security": "FAILURE",
            "Static analysis": "SUCCESS",
            "End-to-end (mobile-chrome)": "IN_PROGRESS",
        },
        "pending": {
            "Quality and security": "PENDING",
            "Static analysis": "IN_PROGRESS",
            "End-to-end (mobile-chrome)": "QUEUED",
        },
        "no_all_green": {"Static analysis": "SUCCESS", "End-to-end (mobile-chrome)": "SUCCESS"},
        "none": {},
    }.get(outcome)
    if states is None:
        print(f"fake gh: unknown check outcome {outcome!r}", file=sys.stderr)
        return 1
    # the real `gh pr checks` exits 8 while checks are pending or failing,
    # and exits 1 with no output before CI has registered any check; the
    # driver's parsing must survive both
    if not states:
        return 1
    print(json.dumps([{"name": name, "state": state} for name, state in states.items()]))
    return 0 if all(state == "SUCCESS" for state in states.values()) else 8


def _work_clone():
    """A clone of the fake origin the merge queue works in, kept between
    calls so a second merge sees the first one's main."""
    work = Path(os.environ["FAKE_WORLD"]) / "merge-queue"
    if not work.exists():
        origin = json.loads((Path(os.environ["FAKE_WORLD"]) / "world.json").read_text())["origin"]
        _git(work.parent, "clone", origin, "merge-queue")
        _git(work, "config", "user.email", "queue@example.com")
        _git(work, "config", "user.name", "Merge queue")
    _git(work, "fetch", "origin", "--prune", "--tags")
    return work


def _git(cwd, *args):
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"fake gh: git {' '.join(args)} failed: {result.stderr}")
    return result.stdout.strip()


def cmd_pr_merge(argv, world):
    """The merge queue's squash merge, for real, in a clone of the fake
    origin - so the merge commit the driver ships is a commit that exists
    and is not any branch the driver pushed. `version-tag.yml` runs on that
    push, so the scripted tag is created here too."""
    number = int(argv[2])
    pull = _pr(world, number)
    if pull is None:
        return 1
    work = _work_clone()
    _git(work, "checkout", "-B", "main", "origin/main")
    _git(work, "merge", "--squash", f"origin/{pull['head']}")
    _git(work, "commit", "-m", f"{pull['title']} (#{number})")
    sha = _git(work, "rev-parse", "HEAD")
    _git(work, "push", "origin", "main")
    tag = world.get("tags", {}).get(f"pr-{number}", world.get("default_tag"))
    if tag:
        _git(work, "tag", tag, sha)
        _git(work, "push", "origin", tag)
    pull["state"] = "MERGED"
    pull["merged"] = True
    pull["mergeCommit"] = sha
    save(world)
    return 0


def cmd_run_list(argv, world):
    if "--commit" in argv:
        return _main_ci_runs(argv, world)
    branch = opt(argv, "--branch")
    print(
        json.dumps(
            [
                {
                    "databaseId": world.setdefault("run_ids", {}).setdefault(branch, 4242),
                    "status": "COMPLETED",
                    "conclusion": "FAILURE",
                }
            ]
        )
    )
    return 0


# One scripted state per poll, per event. "running" is a run that has not
# concluded; the last value of an exhausted list sticks, like the check
# outcomes above.
_RUN_STATES = {
    "queued": ("queued", None),
    "running": ("in_progress", None),
    "success": ("completed", "success"),
    "failure": ("completed", "failure"),
    "cancelled": ("completed", "cancelled"),
}


def _next_state(world, key, default):
    scripted = world.setdefault("main_ci", {}).get(key, default)
    if isinstance(scripted, list) and scripted:
        head = scripted.pop(0)
        if not scripted:
            world["main_ci"][key] = head
        save(world)
        return head
    return scripted if isinstance(scripted, str) else None


def _main_ci_runs(argv, world):
    """`gh run list --workflow ci.yml --commit <sha>`: main's own push run
    and the merge queue's run of the same commit, scripted per PR."""
    sha = opt(argv, "--commit")
    number = next(
        (n for n, pull in world.get("prs", {}).items() if pull.get("mergeCommit") == sha), None
    )
    rows = []
    push = _next_state(world, f"pr-{number}/push", "success")
    if push is not None:
        status, conclusion = _RUN_STATES[push]
        rows.append(
            {
                "databaseId": 7001,
                "event": "push",
                "status": status,
                "conclusion": conclusion,
                "headSha": sha,
                "headBranch": "main",
                "url": "https://github.test/runs/7001",
            }
        )
    merge_group = _next_state(world, f"pr-{number}/merge_group", None)
    if merge_group is not None:
        status, conclusion = _RUN_STATES[merge_group]
        rows.append(
            {
                "databaseId": 7002,
                "event": "merge_group",
                "status": status,
                "conclusion": conclusion,
                "headSha": sha,
                "headBranch": f"gh-readonly-queue/main/pr-{number}-{sha[:7]}",
                "url": "https://github.test/runs/7002",
            }
        )
    print(json.dumps(rows))
    return 0


def cmd_run_rerun(argv, world):
    print(f"reran failed jobs of run {argv[-1]}")
    return 0


COMMANDS = {
    ("issue", "list"): cmd_list,
    ("issue", "view"): cmd_view,
    ("issue", "edit"): cmd_edit,
    ("issue", "comment"): cmd_comment,
    ("issue", "create"): cmd_create,
    ("issue", "close"): cmd_issue_close,
    ("pr", "create"): cmd_pr_create,
    ("pr", "view"): cmd_pr_view,
    ("pr", "checks"): cmd_pr_checks,
    ("pr", "merge"): cmd_pr_merge,
    ("run", "list"): cmd_run_list,
    ("run", "rerun"): cmd_run_rerun,
}


def _match_key(argv):
    """argv joined, minus any --body value - a scripted failure substring
    must never accidentally match text a comment quotes back (e.g. a prior
    failure's own message)."""
    filtered = []
    skip_next = False
    for arg in argv:
        if skip_next:
            skip_next = False
            continue
        if arg == "--body":
            skip_next = True
            continue
        filtered.append(arg)
    return " ".join(filtered)


def main() -> int:
    argv = sys.argv[1:]
    record(argv)
    world = load()
    if any(substring in _match_key(argv) for substring in world.get("gh_failures", [])):
        print(f"fake gh: scripted failure on {' '.join(argv)}", file=sys.stderr)
        return 1
    body = opt(argv, "--body")
    if body and world.get("gh_fail_on_body"):
        for index, substring in enumerate(list(world["gh_fail_on_body"])):
            if substring in body:
                # one-shot: gh blips on this comment, then recovers
                del world["gh_fail_on_body"][index]
                save(world)
                print("fake gh: scripted body failure", file=sys.stderr)
                return 1
    if argv[0] == "api":
        return cmd_api(argv, world)
    if "-R" in argv:
        i = argv.index("-R")
        del argv[i : i + 2]
    handler = COMMANDS.get(tuple(argv[:2]))
    if handler is None:
        print(f"fake gh: unsupported command {argv}", file=sys.stderr)
        return 1
    lock_path = Path(os.environ["FAKE_WORLD"]) / "world.lock"
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return handler(argv, load())


if __name__ == "__main__":
    sys.exit(main())
