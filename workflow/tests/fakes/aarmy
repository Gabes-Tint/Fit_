#!/usr/bin/env python3
# https://github.com/Gabes-Tint/Fit_/issues/351
# cspell:ignore fcntl iterdir
"""Fake `aarmy`: `talk` pops the next scripted turn for "<team>/<role>",
applies effects inside the team's worktree, and prints the reply shape a
real `aarmy talk --schema` prints. `create`/`delete` succeed trivially."""

import json
import os
import subprocess
import sys
import time
import fcntl
from pathlib import Path


def world_dir():
    return Path(os.environ["FAKE_WORLD"])


def world_path():
    return world_dir() / "world.json"


def load():
    return json.loads(world_path().read_text())


def save(world):
    path = world_path()
    tmp = path.with_suffix(f".json.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(world, indent=2))
    tmp.replace(path)


def record(entry):
    with (world_dir() / "calls.jsonl").open("a") as f:
        f.write(json.dumps(entry) + "\n")


def teams_dir():
    return Path(os.environ["AGENTS_ARMY_TEAMS_DIR"])


def opt(argv, name):
    return argv[argv.index(name) + 1] if name in argv else None


def cmd_delete(argv):
    team = opt(argv, "--team")
    marker = teams_dir() / team
    if not marker.exists():
        print(f"team '{team}' not found", file=sys.stderr)
        return 1
    print(f"deleted team '{team}'")
    return 0


def cmd_talk(argv):
    role = argv[1]
    team = opt(argv, "--team")
    if "-p" in argv:
        prompt_text = opt(argv, "-p")
    else:
        prompt_text = Path(opt(argv, "--prompt-file")).read_text()
    record({"tool": "aarmy", "argv": argv, "prompt": prompt_text})
    key = f"{team}/{role}"
    lock_path = world_dir() / "world.lock"
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        world = load()
        turns = world.get("turns", {}).get(key, [])
        if not turns:
            print(f"fake aarmy: no scripted turn left for {key}", file=sys.stderr)
            return 1
        turn = turns.pop(0)
        save(world)
    if turn.get("rendezvous"):
        wait_for_peers(turn["rendezvous"], team)
    effects = turn.get("effects")
    if effects:
        apply_effects(team, effects)
    exit_code = turn.get("exit", 0)
    if exit_code != 0:
        record_finished(role, team, False)
        print(turn.get("message", "turn failed"), file=sys.stderr)
        return exit_code
    record_finished(role, team, True)
    # a session id is per (team, role) pair; a scripted turn may override it
    # (session=), drop it entirely (omit_session), or replace the reply body
    # with raw text (raw_reply) to test the driver's parsing rules.
    session = turn.get("session") or f"{team}/{role}"
    body = turn["raw_reply"] if turn.get("raw_reply") is not None else json.dumps(
        turn["reply"], indent=2, sort_keys=True
    )
    if turn.get("omit_session"):
        print(body)
    else:
        print(f"[{role} session={session}]")
        print(body)
    return 0


def record_finished(role, team, ok):
    record({"tool": "fake", "event": "agent_finished", "role": role, "team": team, "ok": ok})


def wait_for_peers(name, team):
    rendezvous = world_dir() / f"rendezvous-{name}"
    rendezvous.mkdir(exist_ok=True)
    (rendezvous / team).touch()
    deadline = time.monotonic() + 5
    while len(list(rendezvous.iterdir())) < 2:
        if time.monotonic() >= deadline:
            print(f"fake aarmy: rendezvous {name} timed out", file=sys.stderr)
            sys.exit(92)
        time.sleep(0.01)


def apply_effects(team, effects):
    worktree = teams_dir() / team / "worktree"
    for path, content in effects.get("files", {}).items():
        target = worktree / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content)
    for path in effects.get("delete", []):
        target = worktree / path
        if target.exists():
            target.unlink()
    if effects.get("commit"):
        subprocess.run(["git", "add", "-A"], cwd=worktree, check=True, capture_output=True)
        message = effects.get("commit_message", "test: commit")
        subprocess.run(
            ["git", "commit", "-m", message], cwd=worktree, check=True, capture_output=True
        )
    if effects.get("push"):
        branch = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            cwd=worktree,
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        subprocess.run(
            ["git", "push", "-u", "origin", branch], cwd=worktree, check=True, capture_output=True
        )


def main() -> int:
    verb = sys.argv[1]
    argv = sys.argv[1:]
    if verb == "delete":
        return cmd_delete(argv)
    if verb == "create":
        return 0
    if verb == "talk":
        return cmd_talk(argv)
    print(f"fake aarmy: unsupported verb {verb}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
