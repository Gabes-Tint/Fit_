#!/usr/bin/env python3
"""Fake `aarmy`: `talk` pops the next scripted turn for "<team>/<role>",
applies effects inside the team's worktree, and prints the reply shape a
real `aarmy talk --schema` prints. Keeps a small per-team agent registry
under `<team>/agents/registry.json` (roles talked to or created), so `list
agents --team <team>` behaves like the real thing for `fitflow.agents`'s
`existing_roles()`. `delete` only removes what this fake itself tracks."""

import json
import os
import subprocess
import sys
from pathlib import Path


def world_dir():
    return Path(os.environ["FAKE_WORLD"])


def world_path():
    return world_dir() / "world.json"


def load():
    return json.loads(world_path().read_text())


def save(world):
    world_path().write_text(json.dumps(world, indent=2))


def record(entry):
    with (world_dir() / "calls.jsonl").open("a") as f:
        f.write(json.dumps(entry) + "\n")


def teams_dir():
    return Path(os.environ["AGENTS_ARMY_TEAMS_DIR"])


def opt(argv, name):
    return argv[argv.index(name) + 1] if name in argv else None


def registry_path(team):
    return teams_dir() / team / "agents" / "registry.json"


def load_registry(team):
    path = registry_path(team)
    if not path.exists():
        return {"roles": []}
    return json.loads(path.read_text())


def add_role(team, role):
    path = registry_path(team)
    path.parent.mkdir(parents=True, exist_ok=True)
    registry = load_registry(team)
    if role not in registry["roles"]:
        registry["roles"].append(role)
    path.write_text(json.dumps(registry))


def cmd_delete(argv):
    team = opt(argv, "--team")
    marker = teams_dir() / team
    if not marker.exists():
        print(f"team '{team}' not found", file=sys.stderr)
        return 1
    print(f"deleted team '{team}'")
    return 0


def cmd_create(argv):
    role = argv[1]
    team = opt(argv, "--team")
    add_role(team, role)
    return 0


def cmd_list_agents(argv):
    team = opt(argv, "--team")
    registry = load_registry(team)
    print(f"registry: {registry_path(team)}")
    if not registry["roles"]:
        print("no agents")
        return 0
    for role in sorted(registry["roles"]):
        print(f"{role:<20}  backend=claude  model=x  effort=x  turns=0  created=-  last=-  session=-")
    return 0


def cmd_talk(argv):
    role = argv[1]
    team = opt(argv, "--team")
    if "-p" in argv:
        prompt_text = opt(argv, "-p")
    else:
        prompt_text = Path(opt(argv, "--prompt-file")).read_text()
    record({"tool": "aarmy", "argv": argv, "prompt": prompt_text})
    world = load()
    key = f"{team}/{role}"
    turns = world.get("turns", {}).get(key, [])
    if not turns:
        print(f"fake aarmy: no scripted turn left for {key}", file=sys.stderr)
        return 1
    turn = turns.pop(0)
    save(world)
    exit_code = turn.get("exit", 0)
    if exit_code != 0:
        print(turn.get("message", "turn failed"), file=sys.stderr)
        return exit_code
    add_role(team, role)
    effects = turn.get("effects")
    if effects:
        apply_effects(team, effects)
    print(f"[{role} session=fake]")
    print(json.dumps(turn["reply"], indent=2, sort_keys=True))
    return 0


def apply_effects(team, effects):
    worktree = teams_dir() / team / "worktree"
    for path, content in effects.get("files", {}).items():
        target = worktree / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content)
    if effects.get("commit"):
        subprocess.run(["git", "add", "-A"], cwd=worktree, check=True, capture_output=True)
        message = effects.get("commit_message", "test: commit")
        subprocess.run(
            ["git", "commit", "-m", message], cwd=worktree, check=True, capture_output=True
        )
    if effects.get("push"):
        branch = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            cwd=worktree,
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        subprocess.run(
            ["git", "push", "-u", "origin", branch], cwd=worktree, check=True, capture_output=True
        )


def main() -> int:
    verb = sys.argv[1]
    argv = sys.argv[1:]
    if verb == "delete":
        return cmd_delete(argv)
    if verb == "create":
        return cmd_create(argv)
    if verb == "talk":
        return cmd_talk(argv)
    if argv[:2] == ["list", "agents"]:
        return cmd_list_agents(argv)
    print(f"fake aarmy: unsupported verb {verb}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
