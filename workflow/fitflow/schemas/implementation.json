{
	"type": "object",
	"additionalProperties": false,
	"required": ["changed_files", "summary", "objection"],
	"properties": {
		"changed_files": {
			"type": "array",
			"items": { "type": "string" }
		},
		"summary": { "type": "string" },
		"objection": {
			"type": ["object", "null"],
			"additionalProperties": false,
			"required": ["kind", "tests", "why", "proposed_fix"],
			"properties": {
				"kind": {
					"enum": ["tests_contradict", "tests_out_of_layer", "tests_wrong"]
				},
				"tests": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string" }
				},
				"why": { "type": "string" },
				"proposed_fix": { "type": ["string", "null"] }
			}
		}
	}
}
